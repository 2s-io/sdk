{
  "name": "@2sio/mcp",
  "version": "0.30.0",
  "mcpName": "io.github.2s-io/mcp",
  "description": "MCP server exposing 2s.io's ever-expanding catalog of pay-per-call AI agent APIs as Model Context Protocol tools. Settled in USDC on Base or Solana via x402.",
  "license": "MIT",
  "homepage": "https://2s.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/2s-io/sdk.git",
    "directory": "packages/2s-mcp"
  },
  "bugs": {
    "url": "https://github.com/2s-io/sdk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "ai-agents",
    "claude-desktop",
    "agentkit",
    "tools",
    "2s.io",
    "usdc",
    "base"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "2sio-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@2sio/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
