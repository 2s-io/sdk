{
  "name": "@2sio/sdk",
  "version": "1.3.0",
  "description": "Typed client for 2s.io — pay-per-call AI agent APIs on Base or Solana via x402.",
  "license": "MIT",
  "homepage": "https://2s.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/2s-io/sdk.git",
    "directory": "packages/2s-sdk"
  },
  "bugs": {
    "url": "https://github.com/2s-io/sdk/issues"
  },
  "keywords": [
    "x402",
    "ai-agents",
    "agentic",
    "usdc",
    "base",
    "solana",
    "pay-per-call",
    "2s.io",
    "api-sdk",
    "stablecoin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0",
    "@x402/svm": "^2.13.0",
    "@solana/kit": "^5.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
